{
  "name": "mrr-validator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/chaos/**",
    "test:watch": "vitest",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "shadow": "tsx src/scripts/shadow.ts",
    "job": "tsx src/scripts/run-job.ts",
    "autonomy:enable": "tsx src/scripts/autonomy.ts enable",
    "autonomy:disable": "tsx src/scripts/autonomy.ts disable",
    "setup-check": "tsx src/scripts/setup-check.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:chaos && npm run build",
    "simulate": "tsx src/scripts/simulate.ts",
    "test:chaos": "vitest run tests/chaos",
    "canary:email": "tsx src/scripts/canary-email.ts",
    "canary:research": "tsx src/scripts/canary-research.ts",
    "providers:health": "tsx src/scripts/providers-health.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@electric-sql/pglite": "^0.5.8",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.1",
    "next": "^16.3.5",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.28.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
