# ============================================================================
# MRR VALIDATOR — environment configuration
# Copy to `.env` and fill in. See SETUP.md for where each value comes from.
# Everything with a default can be left unset.
# ============================================================================

# --- SAFETY SWITCHES (leave false until /setup-check is all green) ---------
# Master switch. false => SHADOW MODE (research + draft, never send).
AUTONOMY_ENABLED=false
# Separate switch for outbound email. Both must be true to send anything.
OUTREACH_ENABLED=false
# Emergency stop. true => every job refuses to run.
KILL_SWITCH=false

# --- DATABASE --------------------------------------------------------------
# Supabase: Project Settings > Database > Connection string > URI (use the
# "Session pooler" / port 5432 string). Leave BLANK to use local PGlite,
# which requires no credentials and is what shadow mode uses by default.
DATABASE_URL=
# 'auto' (postgres if DATABASE_URL set, else pglite) | 'postgres' | 'pglite'
DATABASE_MODE=auto
# Where PGlite stores its data when in pglite mode.
PGLITE_DATA_DIR=.pgdata

# --- LLM PROVIDER ----------------------------------------------------------
# 'anthropic' | 'mock'. 'mock' needs no key and is used by shadow mode/tests.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Cheap model: classification, extraction, qualification, reply triage.
LLM_FAST=claude-haiku-4-5
# Reasoning model: complaint clustering, wedge synthesis, build spec. ONLY.
LLM_REASONER=claude-sonnet-5
# USD per 1M tokens, used by the cost ledger. Update if pricing changes.
LLM_FAST_INPUT_COST_PER_MTOK=1.00
LLM_FAST_OUTPUT_COST_PER_MTOK=5.00
LLM_REASONER_INPUT_COST_PER_MTOK=2.00
LLM_REASONER_OUTPUT_COST_PER_MTOK=10.00

# --- SEARCH ----------------------------------------------------------------
# 'brave' | 'mock'
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_COST_PER_CALL_USD=0.005
SEARCH_CACHE_TTL_HOURS=168

# --- EMAIL (Resend) --------------------------------------------------------
# 'resend' | 'mock'
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Signing secret from the Resend webhook you create (starts whsec_).
RESEND_WEBHOOK_SECRET=
# Secret for the inbound-email webhook (can be the same value).
RESEND_INBOUND_WEBHOOK_SECRET=

# --- SENDER IDENTITY (legally required in outbound email) ------------------
OWNER_NAME=
# The only address `npm run canary:email` will ever contact. Use a mailbox you
# control and can reply from: the canary verifies the full round trip, including
# an inbound reply. Kept separate from OWNER_NOTIFICATION_EMAIL on purpose.
OWNER_TEST_EMAIL=

OWNER_NOTIFICATION_EMAIL=
SENDER_COMPANY=
SENDER_EMAIL=
# Must be a real postal address. Required by CAN-SPAM.
SENDER_POSTAL_ADDRESS=
# Domain verified in Resend. Used for From:, List-Unsubscribe, SPF/DKIM.
SENDING_DOMAIN=
# Comma-separated ISO-3166 alpha-2. MVP default is US-only.
ALLOWED_OUTREACH_COUNTRIES=US
# Local-time window (24h, sender's TZ) in which outreach may be sent.
SENDING_WINDOW_START_HOUR=8
SENDING_WINDOW_END_HOUR=17
SENDING_TIMEZONE=America/New_York
# Skip weekends for outbound.
SENDING_WEEKDAYS_ONLY=true

# --- DEPLOYMENT ------------------------------------------------------------
# Public base URL. Landing pages and unsubscribe links are built from this.
PUBLIC_BASE_URL=http://localhost:3000
# Token protecting /admin and internal APIs. Generate: openssl rand -hex 32
ADMIN_TOKEN=
# Token the scheduler must present to POST /api/cron. openssl rand -hex 32
CRON_SECRET=
# Secret used to sign unsubscribe links. openssl rand -hex 32
UNSUBSCRIBE_SECRET=

# --- BUDGETS (product requirement, not a suggestion) -----------------------
MONTHLY_LLM_BUDGET_USD=20
MONTHLY_SEARCH_BUDGET_USD=5
MAX_EMAILS_PER_DAY=75
MAX_NEW_CAMPAIGNS_PER_WEEK=3

# --- AUTONOMY PARAMETERS ---------------------------------------------------
DISCOVERY_CANDIDATES_PER_DAY=20
DEEP_VERIFICATIONS_PER_DAY=3
MAX_ACTIVE_VALIDATIONS=2
MIN_QUALIFIED_PROSPECTS=100
PREFERRED_QUALIFIED_PROSPECTS=250
INITIAL_EMAIL_BATCH=25
SECOND_EMAIL_BATCH=50
MAX_EMAILS_PER_CAMPAIGN=150
MAX_FOLLOWUPS=2
FOLLOWUP_1_DELAY_DAYS=4
FOLLOWUP_2_DELAY_DAYS=8
MAX_MVP_BUILD_DAYS=7

# --- READY_TO_BUILD GATE (all thresholds live here, never in a prompt) -----
MIN_UNIQUE_STRONG_COMMITMENTS=5
MIN_UNIQUE_PRICE_ACCEPTANCES=3
MIN_UNIQUE_ACTION_COMMITMENTS=2
MIN_DELIVERED_BEFORE_STANDARD_EVALUATION=75
MIN_QUALIFIED_PROSPECTS_FOR_GATE=100
# Positive-intent rate among delivered emails, as a fraction (0.04 = 4%).
MIN_POSITIVE_INTENT_RATE=0.04
REQUIRED_CATEGORY_EVIDENCE_CONFIDENCE=HIGH

# --- CAMPAIGN HEALTH / KILL RULES -----------------------------------------
MAX_HARD_BOUNCE_RATE=0.05
MAX_COMPLAINT_RATE=0.0
MAX_UNSUBSCRIBE_RATE=0.05

# --- OPTIONAL: monetary validation (OFF by default, never auto-enabled) ----
ENABLE_PAYMENT_METHOD_VALIDATION=false
EXTREME_VALIDATION=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- FETCHING --------------------------------------------------------------
USER_AGENT=MRRValidatorBot/0.1 (+https://example.com/bot; research crawler)
FETCH_TIMEOUT_MS=15000
FETCH_MAX_RETRIES=3
FETCH_MIN_DELAY_MS=1200
RESPECT_ROBOTS_TXT=true

# --- LOGGING ---------------------------------------------------------------
LOG_LEVEL=info

# ============================================================================
# AUTONOMY — CONTROL PLANE
#
# Everything below is typed configuration the running system may READ but can
# never WRITE. There is deliberately no database row for any of it, so no
# amount of model output can widen a limit or lower a gate.
# ============================================================================

# The system starts itself once configuration is complete. If something is
# missing it parks in BLOCKED_CONFIGURATION, tells you exactly what, and
# promotes itself to RUNNING when you fix it — no second command.
AUTO_START=true
SUPERVISOR_INTERVAL_MINUTES=15
# Interested prospects should be answered inside this window, not on a daily batch.
REPLY_LATENCY_TARGET_MINUTES=15

# --- concurrency: stops runaway work ---------------------------------------
MAX_RESEARCH_OPPORTUNITIES=10
MAX_DEEP_RESEARCH_OPPORTUNITIES=3
MAX_ACTIVE_VALIDATIONS=2
MAX_UNSENT_PROSPECTS=600
MAX_MONTHLY_EXPERIMENTS=8

# --- learning ---------------------------------------------------------------
# Share of allocation always reserved for untried hypotheses, so the system
# cannot get trapped exploiting one niche.
EXPLORATION_RATIO=0.25
# Below this many trials an arm may not be called a winner. This is what stops
# "2 replies out of 9" from steering future strategy.
MIN_SAMPLE_SIZE=30
MIN_DELIVERED_FOR_VARIANT_COMPARISON=40
# Downstream reward weights. Opens and clicks are deliberately absent.
REWARD_STRONG_COMMITMENT=1.0
REWARD_PRICE_ACCEPTANCE=0.8
REWARD_PILOT_SIGNUP=0.7
REWARD_STRONG_REPLY=0.3
REWARD_QUALIFIED_REPLY=0.1
# How structurally similar a new idea must be to a past failure to be refused.
FAILURE_SIMILARITY_THRESHOLD=0.8

# --- sub-budgets (shares of MONTHLY_LLM_BUDGET_USD) -------------------------
# These may borrow from each other's unused allocation. Their sum can never
# exceed the global ceiling, which stays hard.
BUDGET_DISCOVERY_PCT=0.15
BUDGET_RESEARCH_PCT=0.30
BUDGET_PROSPECTING_PCT=0.25
BUDGET_REPLY_PCT=0.20
BUDGET_FINAL_ANALYSIS_PCT=0.10

# --- deliverability: volume is earned, never assumed ------------------------
# Cumulative per-campaign ramp. A campaign does not jump to 150.
CAMPAIGN_RAMP_STEPS=10,25,50,75
# Domain warm-up as day:max-per-day. A brand-new sending domain does not get
# 75/day on day one. After the last entry, MAX_EMAILS_PER_DAY applies.
DOMAIN_WARMUP_SCHEDULE=2:10,4:20,7:35
DELIVERABILITY_PAUSE_COOLDOWN_HOURS=24

# --- company fatigue --------------------------------------------------------
# The same business is not pulled into unrelated experiments repeatedly.
COMPANY_COOLDOWN_DAYS=90
NEGATIVE_REPLY_COOLDOWN_DAYS=365

# --- evidence staleness (hours) --------------------------------------------
# Pricing is refreshed before final validation; platform capability before any
# build recommendation; prospect evidence before outreach if old.
EVIDENCE_PRICING_TTL_HOURS=336
EVIDENCE_PLATFORM_TTL_HOURS=720
EVIDENCE_PROSPECT_TTL_HOURS=720

# --- the stronger validation tier ------------------------------------------
# Off by default and never enabled automatically. When on, VALIDATED_REVENUE_INTENT
# requires price-accepted reservations AND one of: a real refundable deposit,
# saved payment methods, or immediate install requests.
ENABLE_PAID_VALIDATION=false
REVENUE_INTENT_MIN_RESERVATIONS=5
REVENUE_INTENT_MIN_DEPOSITS=1
REVENUE_INTENT_MIN_PAYMENT_METHODS=3
REVENUE_INTENT_MIN_INSTALL_REQUESTS=3

# --- provider fallback ------------------------------------------------------
# If the primary model is unavailable and a fallback is configured, the system
# degrades to it. With none, AI-dependent work pauses while deterministic work
# continues — it never guesses to stay busy.
LLM_FALLBACK_PROVIDER=
LLM_FAST_FALLBACK=
LLM_REASONER_FALLBACK=
